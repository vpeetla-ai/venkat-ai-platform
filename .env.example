# Copy to backend/.env and frontend/.env.local as needed

# --- App ---
APP_ENV=development
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL & Redis (docker-compose defaults) ---
DATABASE_URL=postgresql+asyncpg://vap:vap@localhost:5432/venkat_ai_platform
REDIS_URL=redis://localhost:6379/0

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=vap_documents

# --- Pinecone (optional; dual-index / cloud DR) ---
PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_ENVIRONMENT=

# --- LLM providers (set at least one) ---
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Default routing: openrouter | openai | groq | anthropic
LLM_DEFAULT_PROVIDER=openrouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Embeddings: openai | cohere | local ---
EMBEDDING_PROVIDER=openai
COHERE_API_KEY=

# --- Langfuse ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Web & news ---
TAVILY_API_KEY=
NEWSAPI_API_KEY=

# --- Market data (not financial advice; for research automation only) ---
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=

# --- Notifications ---
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# WhatsApp via Twilio (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+1xxxxxxxxxx

# --- Salesforce (Phase 8 — optional) ---
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_INSTANCE_URL=

# --- Personal OS context files (optional; newline-delimited text/markdown/json snippets) ---
CALENDAR_CONTEXT_PATH=
BUDGET_SUMMARY_PATH=
MEETING_CONTEXT_PATH=

# --- Persistence ---
ENABLE_DB_PERSISTENCE=true

# --- AegisAI governance gateway (optional) ---
# When set, VAP requests tool authorization before Slack/Telegram/WhatsApp delivery
AEGISAI_API_BASE_URL=
AEGISAI_GATEWAY_ENABLED=true
AEGISAI_GATEWAY_FAIL_OPEN=true
AEGISAI_AGENT_ID=venkat-ai-platform
AEGISAI_TENANT_ID=bank-demo
AEGISAI_PRINCIPAL_ID=vap-orchestrator
AEGISAI_AUTH_BEARER=
AEGISAI_ROLES=workflow_owner,execution_broker

# --- Enterprise RAG Platform (optional knowledge layer) ---
ENTERPRISE_RAG_ENABLED=false
ENTERPRISE_RAG_API_BASE_URL=http://localhost:8080
ENTERPRISE_RAG_API_KEY=
ENTERPRISE_RAG_TENANT_ID=acme
ENTERPRISE_RAG_USER_ID=vap-orchestrator
ENTERPRISE_RAG_GROUPS=engineering,ai-platform

# Enable with DAILY_BRIEF_ENABLED=true and run: arq app.worker.settings.WorkerSettings
DAILY_BRIEF_ENABLED=false
DAILY_BRIEF_HOUR_UTC=7
DAILY_BRIEF_MINUTE=0
DAILY_BRIEF_CHANNELS=slack
